# Copiá este archivo a .env (o corré ./scripts/init-env.sh, que lo genera con contraseñas aleatorias).
POSTGRES_DB=honeypot
POSTGRES_PASSWORD=cambiar
DB_OWNER_PASSWORD=cambiar
DB_INGEST_PASSWORD=cambiar
DB_ENGINE_PASSWORD=cambiar
DB_API_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
# Secreto compartido api <-> lab-runner (laboratorio de ataques)
# Token del lab-runner (mín. 16 caracteres): generalo con  openssl rand -hex 32
LAB_RUNNER_TOKEN=
# Contraseña de los 3 usuarios de demostración (mín. 12 caracteres)
DEMO_PASSWORD=cambiar-por-una-clave-larga
# Cowrie v3.1.5 fijada por digest (verificada en macOS, riesgo R5)
COWRIE_IMAGE=cowrie/cowrie@sha256:797d45ca8823d313bec0994232b982f3b99412d4e68e234608d6c1f78d32e3fe
# Reinicio del laboratorio desde Mi perfil (solo ADMIN_INFRA). Herramienta de laboratorio: en producción debe ser false.
LAB_RESET_ENABLED=true
